# Makefile for QuakeSpasm on the Sega Dreamcast (KallistiOS + GLdc + SDL2 + sh4zam).
#
# Usage (from a KOS environment -- source /opt/toolchains/dc/kos/environ.sh):
#   make -f Makefile.dreamcast
#
# Produces quakespasm.elf. Convert to a bootable image with mkdcdisc/scramble.

ifndef KOS_BASE
$(error Source the KOS environment first: . /opt/toolchains/dc/kos/environ.sh)
endif

# ---------------------------
# Feature toggles
# ---------------------------
# Music codecs. Start minimal (WAVE only) for a clean first link; enable more
# once the base build boots.
USE_CODEC_WAVE  ?= 1
USE_CODEC_VORBIS?= 1
USE_CODEC_MP3   ?= 0
USE_CODEC_OPUS  ?= 0

# ---------------------------
# Toolchain / flags
# ---------------------------
CC       = kos-cc
LINKER   = kos-cc

SDL2_PREFIX = $(KOS_BASE)/addons

INCLUDES = -I. \
           -I$(SDL2_PREFIX)/include \
           -I$(SDL2_PREFIX)/include/SDL2 \
           -I$(KOS_PORTS)/include \
           -I$(KOS_PORTS)/zlib/inst/include \
           -I$(KOS_PORTS)/sh4zam/inst/include

DEFINES  = -DPLATFORM_DREAMCAST -DUSE_SDL2 -DNO_SDL_CONFIG -DGLQUAKE

# Optimize for SIZE by default: smaller code lowers the heap break, which the
# runtime hunk probe (DC_HeapSize) turns directly into more hunk. Hot math is
# built for SPEED (-O3) via a dedicated rule below.
OPT_SIZE  = -Os
OPT_SPEED = -O3
BASEFLAGS = -ffast-math -fomit-frame-pointer -Wall -Wno-trigraphs \
            $(INCLUDES) $(DEFINES)

CFLAGS      = $(OPT_SIZE)  $(BASEFLAGS)
# Speed build of the hot paths (mathlib + the PVR render modules). Derived from
# the final CFLAGS so it keeps every feature define (USE_PVR_RENDER, codecs) --
# it just swaps -Os for -O3. CFLAGS is expanded lazily, so the conditional
# defines appended below are included.
CFLAGS_SPEED = $(filter-out $(OPT_SIZE),$(CFLAGS)) $(OPT_SPEED)

# Strip symbols/debug info from the linked ELF (-s). The Dreamcast loads only
# the program segments, so this shrinks the .elf and the packaged .cdi without
# touching runtime code. Build with STRIP= (empty) to keep symbols for gdb.
STRIP ?= -s

# GLdc + SDL2 + SH4 SIMD math. SDL2 needs KOS pthreads. -lm last.
# KOS runtime (kallisti/newlib) is added by kos-cc.
LIBS     = -L$(SDL2_PREFIX)/lib/dreamcast \
           -lSDL2 -lpthread \
           -lppp \
           -lGL -lsh4zam -lz -lm

# ---------------------------
# Codec wiring
# ---------------------------
ifeq ($(USE_CODEC_WAVE),1)
CFLAGS += -DUSE_CODEC_WAVE
endif
ifeq ($(USE_CODEC_VORBIS),1)
# Integer Vorbis (Tremor) + libogg from kos-ports. The Tremor headers pull in a
# bare "ogg.h", so its directory needs to be on the include path; the libs live
# in kos-ports/lib, not the SDL2 addons libdir.
CFLAGS += -DUSE_CODEC_VORBIS -DVORBIS_USE_TREMOR -I$(KOS_PORTS)/include/ogg
LIBS   += -L$(KOS_PORTS)/lib -ltremor -logg
endif
ifeq ($(USE_CODEC_MP3),1)
CFLAGS += -DUSE_CODEC_MP3
LIBS   += -lmp3
endif
ifeq ($(USE_CODEC_OPUS),1)
CFLAGS += -DUSE_CODEC_OPUS
LIBS   += -lopusfile -lopus -logg
endif

# ---------------------------
# Objects
# ---------------------------
# Always-safe music core (codec-specific files added conditionally below).
MUSIC_OBJS = bgmusic.o snd_codec.o snd_wave.o
ifeq ($(USE_CODEC_VORBIS),1)
MUSIC_OBJS += snd_vorbis.o snd_mp3tag.o
endif
ifeq ($(USE_CODEC_MP3),1)
MUSIC_OBJS += snd_mp3.o snd_mp3tag.o
endif
ifeq ($(USE_CODEC_OPUS),1)
MUSIC_OBJS += snd_opus.o
endif

COMOBJ_SND   = snd_dma.o snd_mix.o snd_mem.o $(sort $(MUSIC_OBJS))
USE_NULL_SOUND ?= 0
ifeq ($(USE_NULL_SOUND),1)
SYSOBJ_SND   = snd_null.o
else
SYSOBJ_SND   = snd_sdl.o
endif
SYSOBJ_CDA   = cd_sdl.o
SYSOBJ_INPUT = in_sdl.o
SYSOBJ_GL_VID= gl_vidsdl.o
SYSOBJ_TEXMGR= gl_texmgr.o
SYSOBJ_DRAW  = gl_draw.o
SYSOBJ_NET   = net_bsd.o net_udp.o net_dc.o
SYSOBJ_SYS   = pl_linux.o sys_sdl_unix.o pl_vmu.o pl_vmu_hud.o
SYSOBJ_MAIN  = main_sdl.o

GLOBJS = \
	gl_refrag.o gl_rlight.o gl_rmain.o gl_fog.o gl_rmisc.o \
	r_part.o r_world.o gl_screen.o gl_sky.o gl_warp.o \
	$(SYSOBJ_GL_VID) $(SYSOBJ_DRAW) image.o $(SYSOBJ_TEXMGR) gl_mesh.o \
	r_sprite.o r_alias.o r_brush.o gl_model.o

# ---------------------------
# Native PVR renderer (WIP) -- direct Tile-Accelerator submission that replaces
# GLdc's grow-forever main-RAM vertex lists. Opt-in while it's being built:
#   make -f Makefile.dreamcast USE_PVR_RENDER=1
# For now it just compiles the pvr_*.o modules alongside the GLdc build so we can
# grow them incrementally; the engine still renders through GLdc until wired in.
# ---------------------------
USE_PVR_RENDER ?= 0
PVR_OBJS =
ifeq ($(USE_PVR_RENDER),1)
CFLAGS  += -DUSE_PVR_RENDER
# De-GLfy: the native PVR path does not link GLdc. gl* / glKos* symbols still
# referenced by not-yet-ported render paths are resolved by pvr_glstub.o (no-ops).
LIBS    := $(filter-out -lGL,$(LIBS))
PVR_OBJS = pvr_backend.o pvr_rmath.o pvr_alloc.o pvr_image.o pvr_context.o pvr_clip.o \
           pvr_rmain.o pvr_rsurf.o pvr_warp.o pvr_alias.o pvr_sprite.o pvr_fog.o pvr_glstub.o
# Swap the SDL/GLdc video driver for the native PVR one, and the GL texture
# manager for the PVR-native one (uploads to VRAM, no glTexImage2D). (The gl_
# render modules are swapped for pvr_ ones in later steps; until then the binary
# links but the still-GLdc render path won't run -- not yet bootable.)
SYSOBJ_GL_VID = pvr_vid.o
SYSOBJ_TEXMGR = pvr_texmgr.o
SYSOBJ_DRAW   = pvr_draw.o
endif

# ---------------------------
# QuakeWorld protocol (WIP) -- client-only, runtime-selectable alongside the
# native NetQuake path via the connect command. Opt-in while it's being built:
#   make -f Makefile.dreamcast USE_QW_PROTOCOL=1
# ---------------------------
USE_QW_PROTOCOL ?= 0
QW_OBJS =
ifeq ($(USE_QW_PROTOCOL),1)
CFLAGS  += -DUSE_QW_PROTOCOL
QW_OBJS = qw_net.o qw_netchan.o qw_md4.o qw_crc.o qw_pmove.o qw_cl_input.o qw_cl_parse.o qw_cl_ents.o qw_cl_pred.o qw_cl_slist.o qw_cl_main.o
endif

# ---------------------------
# On-screen function profiler (dcprofiler-style). Opt-in:
#   make -f Makefile.dreamcast USE_DC_PROFILER=1
# Compiles the whole engine with -finstrument-functions so every function calls
# the __cyg_profile hooks in prof_dc.c (which is itself excluded). Emit a .map so
# tools/map2profsyms.py can build prof.syms (address -> name); drop that next to
# the data as /cd/prof.syms. Toggle at runtime with the "prof" cvar.
# ---------------------------
USE_DC_PROFILER ?= 0
PROF_OBJS =
PROF_INSTR =
ifeq ($(USE_DC_PROFILER),1)
PROF_INSTR = -finstrument-functions -finstrument-functions-exclude-file-list=prof_dc
# -fno-lto (overrides KOS's -flto in KOS_CFLAGS): LTO privatises static functions
# with .lto_priv suffixes and inlines across files, so the profiler would show
# mangled/merged names. Disabling it keeps real, per-function symbols.
CFLAGS  += -DUSE_DC_PROFILER $(PROF_INSTR) -fno-lto
LDFLAGS += -Wl,-Map,quakespasm.map -fno-lto
STRIP   =					# keep symbols so sh-elf-nm can build prof.syms
PROF_OBJS = prof_dc.o
endif

OBJS = strlcat.o strlcpy.o $(PVR_OBJS) $(QW_OBJS) $(PROF_OBJS) \
	$(GLOBJS) \
	$(SYSOBJ_INPUT) $(COMOBJ_SND) $(SYSOBJ_SND) $(SYSOBJ_CDA) \
	$(SYSOBJ_NET) net_dgrm.o net_loop.o net_main.o \
	chase.o cl_demo.o cl_input.o cl_main.o cl_parse.o cl_tent.o \
	console.o keys.o osk.o menu.o sbar.o view.o wad.o \
	cmd.o common.o miniz.o crc.o cvar.o cfgfile.o \
	host.o host_cmd.o mathlib.o \
	pr_cmds.o pr_edict.o pr_exec.o \
	sv_main.o sv_move.o sv_phys.o sv_user.o world.o zone.o \
	$(SYSOBJ_SYS) $(SYSOBJ_MAIN)

# ---------------------------
# Rules
# ---------------------------
.PHONY: all clean

all: quakespasm.elf

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

# Hot paths built for speed, not size: the SH4 math and the PVR render modules
# (per-vertex transform/lighting/TA submission) are the per-frame CPU cost.
# mathlib.c ICEs the SH4 gcc under -finstrument-functions (the sh4zam sincos inline
# asm in AngleVectors), so strip the profiler instrumentation from just this file --
# its cost still shows up as self-time in its callers. PROF_INSTR is empty in a
# non-profiler build, so filter-out is a no-op there.
mathlib.o: mathlib.c
	$(CC) $(filter-out $(PROF_INSTR),$(CFLAGS_SPEED)) -c -o $@ $<

pvr_%.o: pvr_%.c
	$(CC) $(CFLAGS_SPEED) -c -o $@ $<

# snd_mix.c is the per-frame audio mixer -- the channel painters (SND_PaintChannel*)
# and the clamp/transfer sample loops run every mix. -Os leaves them tight but not
# scheduled/unrolled; -O3 inlines the painters and unrolls the inner loops for
# better SH4 dual-issue. The code is integer, so output is bit-identical to -Os.
snd_mix.o: snd_mix.c
	$(CC) $(CFLAGS_SPEED) -c -o $@ $<

quakespasm.elf: $(OBJS)
	$(LINKER) $(STRIP) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)

clean:
	rm -f $(OBJS) quakespasm.elf
